    "P2043": { "Name": "length", "Value": "measure", "Unit": "km", "Units": { "Q828224": 1, "Q11573": 0.001, "Q253276": 1.609344, "Q3710": 0.0003048 } },
    "P2044": { "Name": "elevation above sea level", "Value": "measure", "Unit": "m", "Units": { "Q11573": 1, "Q3710": 0.3048, "Q828224": 1000 } },
    "P2046": { "Name": "area", "Value": "measure", "Unit": "km2", "Units": { "Q712226": 1, "Q232291": 2.589988110336, "Q25343": 0.000001, "Q35852": 0.01 } },
    "P2120": { "Name": "radius", "Value": "measure", "Unit": "km", "Units": { "Q828224": 1, "Q11573": 0.001, "Q253276": 1.609344 } }
  }
