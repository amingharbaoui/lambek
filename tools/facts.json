{
  "Description": "What Lambek knows of the world: the facts of Wikidata it reads, written into engine/Lambek/Data/Knowledge/wikidata.facts.gz by tools/Get-LambekFacts.ps1. Each kind is the things of Wikidata that Pattern finds (?e), the best known of them first (by how many Wikipedias have a page on them); Facts are the properties read for that kind, with the rank of each value, so that only the values Wikidata prefers are kept. The labels, other names and descriptions are those in French and English, and the names Wikidata gives for every language at once (mul: Victor Hugo has no French label of his own). Wikidata is CC0: its facts may be copied without asking, Lambek still says where each one comes from. A measure (Value measure) is kept in the Unit given, converted from the Units listed (what one of each unit of Wikidata is worth in it); Where keeps a value only when it is itself known enough (the actors of a film), and asks for those values in a question of their own; Current keeps only what is true today (a statement with an end is left out).",
  "Endpoint": "https://qlever.dev/api/wikidata",
  "Languages": [ "fr", "en", "mul" ],
  "Kinds": [
    {
      "Kind": "country",
      "Pattern": "{ ?e wdt:P31 wd:Q3624078 } UNION { ?e wdt:P31 wd:Q6256 } FILTER NOT EXISTS { ?e wdt:P576 ?end } FILTER NOT EXISTS { ?e wdt:P31 wd:Q3024240 } ?e wikibase:sitelinks ?links .",
      "Facts": [ "P36", "P37", "P38", "P1082", "P30", "P2046", "P463" ]
    },
    {
      "Kind": "city",
      "Pattern": "{ ?e wdt:P31/wdt:P279* wd:Q515 ; wdt:P1082 ?people . FILTER(?people >= 100000) } UNION { ?country wdt:P31 wd:Q3624078 ; wdt:P36 ?e } FILTER NOT EXISTS { ?e wdt:P576 ?end } ?e wikibase:sitelinks ?links .",
      "Facts": [ "P17", "P1082" ]
    },
    {
      "Kind": "person",
      "Pattern": "?e wdt:P31 wd:Q5 ; wikibase:sitelinks ?links . FILTER(?links >= 30)",
      "Facts": [ "P21", "P569", "P570", "P19", "P20", "P27" ]
    },
    {
      "Kind": "book",
      "Pattern": "?e wdt:P31/wdt:P279* wd:Q7725634 ; wdt:P50 ?author ; wikibase:sitelinks ?links . FILTER(?links >= 12)",
      "Facts": [ "P50", "P577", "P179" ]
    },
    {
      "Kind": "film",
      "Pattern": "?e wdt:P31/wdt:P279* wd:Q11424 ; wikibase:sitelinks ?links . FILTER(?links >= 20)",
      "Facts": [ "P57", "P577", "P161", "P162", "P179" ]
    },
    {
      "Kind": "painting",
      "Pattern": "?e wdt:P31 wd:Q3305213 ; wdt:P170 ?painter ; wikibase:sitelinks ?links . FILTER(?links >= 10)",
      "Facts": [ "P170", "P571" ]
    },
    {
      "Kind": "album",
      "Pattern": "?e wdt:P31 wd:Q482994 ; wikibase:sitelinks ?links . FILTER(?links >= 10)",
      "Facts": [ "P175", "P577" ]
    },
    {
      "Kind": "videogame",
      "Pattern": "?e wdt:P31 wd:Q7889 ; wikibase:sitelinks ?links . FILTER(?links >= 15)",
      "Facts": [ "P577", "P179", "P178" ]
    },
    {
      "Kind": "river",
      "Pattern": "?e wdt:P31/wdt:P279* wd:Q4022 ; wikibase:sitelinks ?links . FILTER(?links >= 20)",
      "Facts": [ "P2043", "P17" ]
    },
    {
      "Kind": "mountain",
      "Pattern": "?e wdt:P31/wdt:P279* wd:Q8502 ; wikibase:sitelinks ?links . FILTER(?links >= 20)",
      "Facts": [ "P2044", "P17" ]
    },
    {
      "Kind": "ocean",
      "Pattern": "?e wdt:P31 wd:Q9430 ; wdt:P361 wd:Q715269 ; wikibase:sitelinks ?links .",
      "Facts": [ "P2046" ]
    },
    {
      "Kind": "planet",
      "Pattern": "VALUES ?e { wd:Q308 wd:Q313 wd:Q2 wd:Q111 wd:Q319 wd:Q193 wd:Q324 wd:Q332 } ?e wikibase:sitelinks ?links .",
      "Facts": [ "P2120" ]
    }
  ],
  "Properties": {
    "P17": { "Name": "country", "Value": "item" },
    "P19": { "Name": "place of birth", "Value": "item" },
    "P20": { "Name": "place of death", "Value": "item" },
    "P21": { "Name": "sex or gender", "Value": "item" },
    "P27": { "Name": "country of citizenship", "Value": "item" },
