    "P161": { "Name": "cast member", "Value": "item", "Where": "?v wikibase:sitelinks ?vl . FILTER(?vl >= 15)" },
    "P162": { "Name": "producer", "Value": "item" },
    "P170": { "Name": "creator", "Value": "item" },
    "P175": { "Name": "performer", "Value": "item" },
    "P178": { "Name": "developer", "Value": "item" },
