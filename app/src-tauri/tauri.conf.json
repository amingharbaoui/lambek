{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lambek",
  "version": "0.13.0",
  "identifier": "be.ehb.lambek",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lambek",
        "width": 1280,
        "height": 832,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "backgroundColor": "#161617",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../engine/Lambek/": "engine/Lambek/",
      "../../dsl/": "dsl/"
    }
  }
}
