      "TemplateKey": "Kind",
      "Templates": {
        "Function": [
          "?Language=PowerShell ?Name function {{Name!}} {",
          "?Language=PowerShell !Name function Invoke-Task {",
          "?Language=PowerShell     [CmdletBinding()]",
          "?Language=PowerShell     param()",
          "?Language=PowerShell ",
          "?Language=PowerShell }",
          "?Language=Python ?Name def {{Name!snake}}():",
          "?Language=Python !Name def run_task():",
          "?Language=Python     \"\"\"Say what this function does.\"\"\"",
          "?Language=Python     return None",
          "?Language=JavaScript ?Name function {{Name!camel}}() {",
          "?Language=JavaScript !Name function runTask() {",
          "?Language=JavaScript }",
          "?Language=CSharp static class Tasks",
          "?Language=CSharp {",
          "?Language=CSharp ?Name     public static void {{Name!pascal}}()",
          "?Language=CSharp !Name     public static void RunTask()",
          "?Language=CSharp     {",
          "?Language=CSharp     }",
          "?Language=CSharp }",
          "?Language=Rust ?Name fn {{Name!snake}}() {",
          "?Language=Rust !Name fn run_task() {",
          "?Language=Rust }",
          "?Language=Bash ?Name {{Name!snake}}() {",
          "?Language=Bash !Name run_task() {",
          "?Language=Bash   :",
          "?Language=Bash }"
        ],
        "Script": [
          "?Language=PowerShell [CmdletBinding()]",
          "?Language=PowerShell param()",
          "?Language=PowerShell ",
          "?Language=Python #!/usr/bin/env python3",
          "?Language=Python \"\"\"Say what this script does.\"\"\"",
          "?Language=Python import sys",
          "?Language=Python ",
          "?Language=Python ",
          "?Language=Python def main():",
          "?Language=Python     return 0",
          "?Language=Python ",
          "?Language=Python ",
          "?Language=Python if __name__ == \"__main__\":",
          "?Language=Python     sys.exit(main())",
          "?Language=JavaScript #!/usr/bin/env node",
          "?Language=JavaScript \"use strict\";",
          "?Language=JavaScript ",
          "?Language=JavaScript function main() {",
          "?Language=JavaScript }",
          "?Language=JavaScript ",
          "?Language=JavaScript main();",
          "?Language=CSharp using System;",
          "?Language=CSharp ",
          "?Language=CSharp class Program",
          "?Language=CSharp {",
          "?Language=CSharp     static int Main(string[] args)",
          "?Language=CSharp     {",
          "?Language=CSharp         return 0;",
          "?Language=CSharp     }",
          "?Language=CSharp }",
          "?Language=Rust fn main() {",
          "?Language=Rust }",
          "?Language=Bash #!/usr/bin/env bash",
          "?Language=Bash set -euo pipefail",
          "?Language=Bash ",
          "?Language=Bash main() {",
          "?Language=Bash   :",
          "?Language=Bash }",
          "?Language=Bash ",
          "?Language=Bash main \"$@\""
        ],
        "Class": [
          "?Language=PowerShell ?Name class {{Name!}} {",
          "?Language=PowerShell !Name class NewClass {",
          "?Language=PowerShell ",
          "?Language=PowerShell }",
          "?Language=Python ?Name class {{Name!pascal}}:",
          "?Language=Python !Name class NewClass:",
          "?Language=Python     \"\"\"Say what this class holds.\"\"\"",
          "?Language=Python ",
          "?Language=Python     def __init__(self):",
          "?Language=Python         pass",
          "?Language=JavaScript ?Name class {{Name!pascal}} {",
          "?Language=JavaScript !Name class NewClass {",
          "?Language=JavaScript   constructor() {",
          "?Language=JavaScript   }",
          "?Language=JavaScript }",
          "?Language=CSharp ?Name class {{Name!pascal}}",
          "?Language=CSharp !Name class NewClass",
          "?Language=CSharp {",
          "?Language=CSharp ?Name     public {{Name!pascal}}()",
          "?Language=CSharp !Name     public NewClass()",
          "?Language=CSharp     {",
          "?Language=CSharp     }",
          "?Language=CSharp }",
          "?Language=Rust ?Name pub struct {{Name!pascal}} {",
          "?Language=Rust !Name pub struct NewStruct {",
          "?Language=Rust }",
          "?Language=Rust ",
          "?Language=Rust ?Name impl {{Name!pascal}} {",
          "?Language=Rust !Name impl NewStruct {",
          "?Language=Rust     pub fn new() -> Self {",
          "?Language=Rust         Self {}",
          "?Language=Rust     }",
          "?Language=Rust }",
          "?Language=Bash # Bash has no classes: functions that share a prefix play that part",
          "?Language=Bash ?Name {{Name!snake}}_new() {",
          "?Language=Bash !Name object_new() {",
          "?Language=Bash   :",
          "?Language=Bash }"
        ],
        "Module": [
          "?Language=PowerShell # Save as a .psm1 file: every function in it is exported",
          "?Language=PowerShell ?Name function {{Name!}} {",
          "?Language=PowerShell !Name function Invoke-Task {",
          "?Language=PowerShell     [CmdletBinding()]",
          "?Language=PowerShell     param()",
          "?Language=PowerShell ",
          "?Language=PowerShell }",
          "?Language=Python \"\"\"Say what this module offers.\"\"\"",
          "?Language=Python ",
          "?Language=Python ",
          "?Language=Python ?Name def {{Name!snake}}():",
          "?Language=Python !Name def run_task():",
          "?Language=Python     \"\"\"Say what this function does.\"\"\"",
          "?Language=Python     return None",
          "?Language=JavaScript \"use strict\";",
          "?Language=JavaScript ",
          "?Language=JavaScript ?Name function {{Name!camel}}() {",
          "?Language=JavaScript !Name function runTask() {",
          "?Language=JavaScript }",
          "?Language=JavaScript ",
          "?Language=JavaScript ?Name module.exports = { {{Name!camel}} };",
          "?Language=JavaScript !Name module.exports = { runTask };",
          "?Language=CSharp ?Name namespace {{Name!pascal}}",
          "?Language=CSharp !Name namespace NewModule",
          "?Language=CSharp {",
          "?Language=CSharp     public static class Tasks",
          "?Language=CSharp     {",
          "?Language=CSharp         public static void RunTask()",
          "?Language=CSharp         {",
          "?Language=CSharp         }",
          "?Language=CSharp     }",
          "?Language=CSharp }",
          "?Language=Rust ?Name pub mod {{Name!snake}} {",
          "?Language=Rust !Name pub mod new_module {",
          "?Language=Rust     pub fn run() {",
          "?Language=Rust     }",
          "?Language=Rust }",
          "?Language=Bash # A library: load it with \"source\" from another script",
          "?Language=Bash ?Name {{Name!snake}}() {",
          "?Language=Bash !Name run_task() {",
          "?Language=Bash   :",
          "?Language=Bash }"
        ],
        "Test": [
          "?Language=PowerShell ?Name Describe '{{Name!}}' {",
          "?Language=PowerShell !Name Describe 'Task' {",
          "?Language=PowerShell     It 'works' {",
          "?Language=PowerShell         $true | Should -BeTrue",
          "?Language=PowerShell     }",
          "?Language=PowerShell }",
          "?Language=Python import unittest",
          "?Language=Python ",
          "?Language=Python ",
          "?Language=Python ?Name class Test{{Name!pascal}}(unittest.TestCase):",
          "?Language=Python !Name class TestTask(unittest.TestCase):",
          "?Language=Python     def test_works(self):",
          "?Language=Python         self.assertEqual(1 + 1, 2)",
          "?Language=Python ",
          "?Language=Python ",
          "?Language=Python if __name__ == \"__main__\":",
          "?Language=Python     unittest.main()",
          "?Language=JavaScript const test = require(\"node:test\");",
          "?Language=JavaScript const assert = require(\"node:assert\");",
          "?Language=JavaScript ",
          "?Language=JavaScript ?Name test(\"{{Name!camel}} works\", () => {",
          "?Language=JavaScript !Name test(\"it works\", () => {",
          "?Language=JavaScript   assert.strictEqual(1 + 1, 2);",
          "?Language=JavaScript });",
          "?Language=CSharp using System;",
          "?Language=CSharp ",
          "?Language=CSharp ?Name static class {{Name!pascal}}Tests",
          "?Language=CSharp !Name static class TaskTests",
          "?Language=CSharp {",
          "?Language=CSharp     static void Check(bool condition, string message)",
          "?Language=CSharp     {",
          "?Language=CSharp         if (!condition)",
          "?Language=CSharp         {",
          "?Language=CSharp             throw new Exception(message);",
          "?Language=CSharp         }",
          "?Language=CSharp     }",
          "?Language=CSharp ",
          "?Language=CSharp     static int Main()",
          "?Language=CSharp     {",
          "?Language=CSharp         Check(1 + 1 == 2, \"one plus one is two\");",
          "?Language=CSharp         Console.WriteLine(\"All tests passed.\");",
          "?Language=CSharp         return 0;",
          "?Language=CSharp     }",
          "?Language=CSharp }",
          "?Language=Rust #[cfg(test)]",
          "?Language=Rust mod tests {",
          "?Language=Rust     #[test]",
          "?Language=Rust ?Name     fn {{Name!snake}}_works() {",
          "?Language=Rust !Name     fn it_works() {",
          "?Language=Rust         assert_eq!(1 + 1, 2);",
          "?Language=Rust     }",
          "?Language=Rust }",
          "?Language=Bash #!/usr/bin/env bash",
          "?Language=Bash set -euo pipefail",
          "?Language=Bash ",
          "?Language=Bash ?Name test_{{Name!snake}}() {",
          "?Language=Bash !Name test_task() {",
          "?Language=Bash   [ \"$((1 + 1))\" -eq 2 ]",
          "?Language=Bash }",
          "?Language=Bash ",
          "?Language=Bash ?Name test_{{Name!snake}}",
          "?Language=Bash !Name test_task",
          "?Language=Bash echo \"ok\""
        ]
      },
      "Say": {
        "en": [
          "generate a {Language} {Kind|lower}",
          "?Name named {Name}"
        ],
        "fr": [
          "générer un {Kind|lower} {Language}",
          "?Name nommé {Name}"
        ]
      }
    }
  ],
  "Commands": [
    "Describe",
    "It",
    "Should"
  ],
  "Category": {
    "en": {
      "Title": "Code",
      "Summary": "Generate functions, scripts, classes, modules and tests in PowerShell, Python, JavaScript, C#, Rust or Bash.",
      "Examples": [
