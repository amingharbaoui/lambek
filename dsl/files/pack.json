    {
      "Id": "files.delete",
      "Risk": "high",
      "Title": {
        "en": "Delete files or folders",
        "fr": "Supprimer des fichiers ou dossiers"
      },
      "Verbs": [
        "delete",
        "supprimer"
      ],
      "Examples": {
        "en": [
          "delete files",
          "delete the old files in a folder",
          "remove the log files",
          "erase a folder"
        ],
        "fr": [
          "supprimer des fichiers",
          "supprimer les anciens fichiers dans un dossier",
          "effacer un dossier"
        ]
      },
      "Parameters": [
        {
          "Name": "Path",
          "Entities": [
            "path",
            "quoted"
          ],
          "After": [
            "in",
            "inside",
            "under",
            "dans",
            "sous"
          ],
          "Fallback": true,
          "Required": true,
          "Question": {
            "en": "In which folder?",
            "fr": "Dans quel dossier ?"
          }
        },
        {
          "Name": "Name",
          "Entities": [
            "filename"
          ]
        },
        {
          "Name": "Extension",
          "Entities": [
            "extension"
          ]
        },
        {
          "Name": "OlderThan",
          "Entities": [
            "duration"
          ],
          "After": [
            "old",
            "plus"
          ]
        },
        {
          "Name": "NewerThan",
          "Entities": [
            "duration"
          ],
          "After": [
            "new",
            "moins"
          ]
        },
        {
          "Name": "MinSize",
          "Entities": [
            "size"
          ],
          "After": [
            "larger",
            "plus"
          ]
        },
        {
          "Name": "MaxSize",
          "Entities": [
            "size"
          ],
          "After": [
            "smaller",
            "moins"
          ]
        }
      ],
      "Output": "command",
      "Reads": [],
      "Writes": [
        "Path"
      ],
      "Template": [
        "$items = Get-ChildItem -LiteralPath {{Path}} -File -Recurse",
        "?Name $items = $items | Where-Object Name -EQ {{Name}}",
        "?Extension $items = $items | Where-Object Extension -EQ {{Extension}}",
        "?OlderThan $items = $items | Where-Object LastWriteTime -LT ((Get-Date) - {{OlderThan}})",
        "?NewerThan $items = $items | Where-Object LastWriteTime -GE ((Get-Date) - {{NewerThan}})",
        "?MinSize $items = $items | Where-Object Length -GT {{MinSize}}",
        "?MaxSize $items = $items | Where-Object Length -LT {{MaxSize}}",
        "$items | Remove-Item"
      ],
      "Say": {
        "en": [
          "delete the",
          "?Extension {Extension}",
          "files",
          "?Name named {Name}",
          "?OlderThan older than {OlderThan}",
          "?NewerThan newer than {NewerThan}",
          "?MinSize larger than {MinSize}",
          "?MaxSize smaller than {MaxSize}",
          "in {Path}"
        ],
        "fr": [
          "supprimer les",
          "fichiers",
          "?Extension {Extension}",
          "?Name nomm\u00e9s {Name}",
          "?OlderThan de plus de {OlderThan}",
          "?NewerThan de moins de {NewerThan}",
          "?MinSize de plus de {MinSize}",
          "?MaxSize de moins de {MaxSize}",
          "dans {Path}"
        ]
      }
    },
