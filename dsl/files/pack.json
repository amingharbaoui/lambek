{
  "Name": "files",
  "Version": "0.1.0",
  "Description": "Files and folders: find, list, create, copy, move, rename, and delete.",
  "Types": {
    "o": {
      "en": "Which files or folders?",
      "fr": "Quels fichiers ou dossiers ?"
    },
    "d": {
      "en": "In which folder?",
      "fr": "Dans quel dossier ?"
    },
    "p": {
      "en": "Where to?",
      "fr": "Vers quel emplacement ?"
    },
    "c": {
      "en": "Compared to what?",
      "fr": "Par rapport \u00e0 quoi ?"
    },
    "z": {
      "en": "What size?",
      "fr": "Quelle taille ?"
    },
    "t": {
      "en": "What age or duration?",
      "fr": "Quelle dur\u00e9e ?"
    }
  },
  "Entities": [
    {
      "Name": "path",
      "Priority": 40,
      "Kind": "text",
      "Pattern": "(?<v>(?:[A-Za-z]:\\\\|\\\\\\\\)[^\\s,;\"]*|%[A-Za-z_]+%(?:\\\\[^\\s,;\"]*)?|\\$env:[A-Za-z_]+(?:\\\\[^\\s,;\"]*)?)"
    },
    {
      "Name": "filename",
      "Priority": 45,
      "Kind": "text",
      "Pattern": "(?<v>\\b[\\w-]*[A-Za-z][\\w-]*\\.[A-Za-z][A-Za-z0-9]{0,4}\\b)"
    },
    {
      "Name": "size",
      "Priority": 50,
      "Kind": "unit",
      "Pattern": "(?i)\\b(?<n>\\d+(?:[.,]\\d+)?)\\s?(?<u>bytes?|octets?|gigas?|[kmgt]b|[kmg]o|b)\\b",
      "Units": {
        "b": 1,
        "byte": 1,
        "bytes": 1,
        "octet": 1,
        "octets": 1,
        "kb": 1024,
        "ko": 1024,
        "mb": 1048576,
        "mo": 1048576,
        "gb": 1073741824,
        "go": 1073741824,
        "giga": 1073741824,
        "gigas": 1073741824,
        "tb": 1099511627776
      }
    },
    {
      "Name": "extension",
      "Priority": 70,
      "Kind": "lower",
      "Pattern": "(?<![\\w\\\\])(?<v>\\.[A-Za-z0-9]{1,5})\\b"
    }
  ],
